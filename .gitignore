# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# Local Environment Variables
.env.local
.env.*.local

# Local SQLite Data
*.db
*.sqlite
*.sqlite3
databases/

# Vue/Vite Caches
.eslintcache
dist-ssr/

# Xcode user-specific files
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/
DerivedData/