{
    "name": "car-log",
    "private": true,
    "version": "0.0.1",
    "author": "Alex Holt",
    "license": "UNLICENSED",
    "description": "A cross-platform vehicle maintenance and service history tracking application.",
    "repository": {
        "type": "git",
        "url": "https://github.com/Holtster2000/car-log.git"
    },
    "type": "module",
    "engines": {
        "node": "24.x",
        "npm": ">=11.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "typecheck": "vue-tsc --noEmit",
        "preview": "vite preview",
        "test": "npm run test:unit -- --run && npm run test:integration -- --run",
        "test:e2e": "cypress run",
        "test:unit": "vitest",
        "test:integration": "vitest --config vitest.integration.config.ts",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "fix": "npm run lint:fix && npm run format",
        "check": "npm run lint && npm run format:check && npm test && npm run build",
        "dev:ios": "ionic cap run ios -l --consolelogs --target=\"71A012B1-826A-4C82-88D8-8087BB05B285\" --host=localhost",
        "build:mobile": "npm run build && npx cap sync"
    },
    "dependencies": {
        "@capacitor-community/sqlite": "^8.1.0",
        "@capacitor/android": "^8.4.1",
        "@capacitor/app": "8.1.0",
        "@capacitor/core": "8.4.1",
        "@capacitor/haptics": "8.0.2",
        "@capacitor/ios": "8.4.1",
        "@capacitor/keyboard": "8.0.5",
        "@capacitor/status-bar": "8.0.2",
        "@ionic/vue": "^8.8.12",
        "@ionic/vue-router": "^8.8.12",
        "ionicons": "^8.0.13",
        "jeep-sqlite": "^2.8.0",
        "pinia": "^3.0.4",
        "sql.js": "1.11.0",
        "uuid": "^14.0.1",
        "vue": "^3.5.39",
        "vue-router": "^5.1.0"
    },
    "devDependencies": {
        "@capacitor/cli": "8.4.1",
        "@eslint/js": "^10.0.1",
        "@vitejs/plugin-legacy": "^8.1.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.4.11",
        "cypress": "^15.18.0",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.9.2",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "prettier": "3.8.4",
        "terser": "^5.48.0",
        "typescript": "~6.0.3",
        "vite": "^8.1.0",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^4.1.9",
        "vue-tsc": "^3.3.5"
    },
    "allowScripts": {
        "core-js@3.49.0": true,
        "fsevents@2.3.3": true,
        "cypress@15.18.0": true
    }
}
