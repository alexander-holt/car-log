{
    "name": "car-log",
    "private": true,
    "version": "0.0.1",
    "author": "Alex Holt",
    "license": "UNLICENSED",
    "description": "A cross-platform vehicle maintenance and service history tracking application.",
    "repository": {
        "type": "git",
        "url": "https://github.com/Holtster2000/car-log.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc && vite build",
        "preview": "vite preview",
        "test:e2e": "cypress run",
        "test:unit": "vitest",
        "lint": "eslint .",
        "dev:ios": "ionic cap run ios -l --target=\"71A012B1-826A-4C82-88D8-8087BB05B285\" --host=localhost",
        "build:mobile": "npm run build && npx cap sync"
    },
    "dependencies": {
        "@capacitor-community/sqlite": "^8.1.0",
        "@capacitor/android": "^8.4.1",
        "@capacitor/app": "8.1.0",
        "@capacitor/core": "8.4.1",
        "@capacitor/haptics": "8.0.2",
        "@capacitor/ios": "8.4.1",
        "@capacitor/keyboard": "8.0.5",
        "@capacitor/status-bar": "8.0.2",
        "@ionic/vue": "^8.0.0",
        "@ionic/vue-router": "^8.0.0",
        "ionicons": "^7.0.0",
        "pinia": "^3.0.4",
        "vue": "^3.3.0",
        "vue-router": "^4.2.0"
    },
    "devDependencies": {
        "@capacitor/cli": "8.4.1",
        "@vitejs/plugin-legacy": "^8.1.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/eslint-config-typescript": "^12.0.0",
        "@vue/test-utils": "^2.3.0",
        "cypress": "^13.5.0",
        "eslint": "^8.35.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-vue": "^9.9.0",
        "jsdom": "^22.1.0",
        "terser": "^5.4.0",
        "typescript": "~5.9.0",
        "vite": "^8.1.0",
        "vitest": "^4.1.9",
        "vue-tsc": "^2.1.10"
    },
    "overrides": {
        "minimatch": "^10.2.1",
        "qs": "^6.15.1",
        "uuid": "^11.1.1"
    }
}
